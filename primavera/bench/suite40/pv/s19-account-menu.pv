# The account menu is CSS :hover only.
use common.pv

# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

before each
  goto /shop --wait commit
  run accept-cookies

scenario "Hovering the account menu reveals its links"
  hover --text "Account"
  expect --role link --name "Sign in" visible
  expect --role link --name "Orders" visible
