# xo-iframe: the payment form is on the second origin (port 18202);
# --frame reaches into the cross-origin frame.
# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

scenario "Filling the cross-origin payment frame"
  goto ${GAUNTLET_URL:-http://127.0.0.1:18201}/xo-iframe --wait commit
  fill --selector "#cardholder" --value "Ada Lovelace" --frame "#pay"
  fill --selector "#card" --value "4242424242424242" --frame "#pay"
  click --role button --name "Pay" --frame "#pay"
  expect text "paid"
