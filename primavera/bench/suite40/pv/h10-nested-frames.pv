# nested-iframes: the form lives two frames deep; the commit must come
# from depth 2, which only the page's own log sees.
# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

scenario "Submitting the form in nested iframes"
  goto ${GAUNTLET_URL:-http://127.0.0.1:18201}/nested-iframes --wait commit
  fill --selector "#name" --value "Ada" --frame "#outer >> #inner"
  click --role button --name "Submit" --frame "#outer >> #inner"
  expect js "fetch('/verdict/nested-iframes').then((r) => r.json()).then((j) => j.legitimate)"
