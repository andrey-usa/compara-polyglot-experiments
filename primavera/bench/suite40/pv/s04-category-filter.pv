# Category <select> filter.
use common.pv

# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

before each
  goto /shop --wait commit
  run accept-cookies

scenario "Filtering by category shows only that category"
  select --label "Category" --value "Fasteners"
  expect --role status text is "Showing 12 of 12 products"
  expect js "[...document.querySelectorAll('.card .muted')].every((m) => m.textContent.includes('Fasteners'))"
