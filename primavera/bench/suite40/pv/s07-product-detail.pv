# Product detail page (SPA route /shop/p/<id>); Brass Widget id 101: $60.32, 38 in stock.
use common.pv

# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

before each
  goto /shop --wait commit
  run accept-cookies

scenario "The product page shows name, price and stock"
  goto /shop/p/101 --wait commit
  expect --selector "h1" text is "Brass Widget"
  expect text "Price: $60.32"
  expect --selector "#stock" text is "38"
  click --selector "#back-to-shop"
  expect url ends-with "/shop"
