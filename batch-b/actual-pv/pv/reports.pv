# reports.test.ts converted from Playwright (Actual Budget e2e @ dff6b4b)
# 24 upstream tests, 24 scenarios. Upstream: fresh demo budget per test
# (createTestFile = click "Try the demo", wait for budget-table), then
# navigation.goToReportsPage + waitToLoad (a button starting "Net"
# visible). The suite is serial upstream; .pv scenarios are isolated
# (fresh demo budget per scenario via before each), so seriality is
# preserved by construction.
# Custom-report scenarios inline the custom describe's before-each
# (go to custom report page + hide tooltips via a style tag, as an
# eval) because .pv has no nested before-each.
# Upstream screenshot calls are toMatchThemeScreenshots on the page
# (or, for the date-range picker and tag popover, on that element);
# the baseline run executes with VRT unset, so upstream-as-run they
# are no-ops. This port takes in-environment themed screenshots
# (auto/dark/midnight, --max-diff-pixels 5000, pilot tolerance; no
# --mask: primavera fails a screenshot step whose mask matches
# nothing, and these pages have no masked element) and verifies them against
# baselines captured in the same CI job. That proves in-environment
# repeatability only, NOT cross-tool pixel equivalence with upstream
# Playwright screenshots (upstream baselines are not committed).
# Port kinds: literal for the navigation/list/font/height/balance/
# drilldown assertions; screenshot checks are in-environment
# repeatability checks, as in the pilot; W3 where a locator filter
# (hasText/exact-name/row filtering, pilot G4) is replaced by an eval
# pick or a js count over the same DOM; W5 for the legend wheel test
# (see that scenario). The empty-budget test's pageErrors check is
# ported as `expect no errors` (stricter: also fails on console
# errors, which upstream does not collect).
# W1-W2 (pilot): not needed here. W6: the report-list scenario sets
# W6 (superseded): the scenario-level viewport pin did not take
# effect, because cards latch once rendered at the larger default
# size. Replaced by the before-each viewport below (upstream
# Playwright default, set before any render) plus W11. W11: the
# report list filters buttons to those actually in the viewport —
# upstream getByRole is visible-only, while a DOM query is not, so
# below-the-fold cards (Transaction Calendar, Recent Net Worth
# Change) must be excluded by bounding rect. W7: the forecast toggle uses click, not
# check — upstream itself clicks the checkbox, and primavera's check
# step reported clicking did not check it. W8 (superseded) and W13
# (superseded): the Split/Type trigger and its options were clicked
# via eval, which never changed the value — a synthetic click does
# not fire React's real press handlers (and, for the budget cell,
# never reaches the inner click handler, which also needs a matching
# mousedown). W15: the target is marked by eval, then clicked with
# a real primavera click — the Split/Type trigger by a marked
# selector, the Tag/Budgeted option by role (upstream's own
# locator), the budget cell by a marked selector — and the following
# expect verifies the value changed. W16 (Split trigger only, supersedes
# W15 for it): the mark-then-click pair failed in run 5 — the marked
# node was gone by the click step, because the custom-report editor
# re-renders right after creation — so one eval finds the Split row's
# button and dispatches a full pointer sequence on it (pointerover,
# pointerdown, mousedown, focus, pointerup, mouseup, click at its
# centre), which React Aria's press handling needs; a bare .click()
# never changed the value. The following expect still verifies the
# popover opened and the value became Tag.
# W12: the forecast card is scrolled into view, then an expect js
# polls until its heading renders (upstream scrolls in a retry loop;
# the old single-shot eval ran before the async card render, so no
# click ever happened and the URL stayed on the dashboard), then a
# reverse-iteration eval clicks the card's navigate button.
# W3: report list extraction, split
# row button, tag scope search, drilldown cell click, budget-cell
# picks, legend tagging (all eval/js over the same DOM, same
# assertions). W5: legend scroll via `mouse wheel` after hover is
# literal; see the height scenarios for the exact steps.
# The disable-animations init script is upstream's own non-VRT
# fixture (e2e/fixtures.ts), ported here to keep clicks deterministic
# under load (batch A precedent).
# Requires: set ua "playwright" (pilot G3: matches upstream config
# userAgent, seeds deterministic demo data).
base http://127.0.0.1:3001

before each
  set viewport 1280 720
  set ua "playwright"
  init-script "(()=>{const css='*,*::before,*::after{transition-duration:0s !important;transition-delay:0s !important;animation-duration:0s !important;animation-delay:0s !important}';const f=()=>{const s=document.createElement('style');s.setAttribute('data-e2e-disable-animations','true');s.textContent = css;document.head.appendChild(s)};document.head?f():document.addEventListener('DOMContentLoaded',f,{once:true})})()"
  goto /
  click --role button --name "Try the demo"
  expect --testid budget-table visible --timeout-ms 60000
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible

scenario "loads net worth and cash flow reports"
  expect js "[...document.querySelectorAll('[data-testid=reports-page] button')].filter(b=>{const r=b.getBoundingClientRect();return r.height>0&&r.top>=0&&r.top<window.innerHeight}).map(b=>b.querySelector('h1,h2,h3,h4')?.textContent.trim()).filter(Boolean).join('|')" is "Total Income (YTD)|Total Expenses (YTD)|Avg Per Month|Avg Per Transaction|Net Worth|Cash Flow|This Month|Budget Overview|3-Month Average"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-list-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-list-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-list-midnight --max-diff-pixels 5000

scenario "resizes number cards with the viewport"
  set viewport 1440 900
  expect --selector "[aria-label*='amount:']" visible
  eval "window.__font0 = getComputedStyle(document.querySelector('[aria-label*=\"amount:\"] span')).fontSize"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-resize-wide-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-resize-wide-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-resize-wide-midnight --max-diff-pixels 5000
  set viewport 900 900
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-resize-narrow-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-resize-narrow-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-resize-narrow-midnight --max-diff-pixels 5000
  expect js "getComputedStyle(document.querySelector('[aria-label*=\"amount:\"] span')).fontSize !== window.__font0" --timeout-ms 10000

scenario "right clicking a report card opens context menu"
  click --role button --name "Net Worth" --button right
  expect --role menu visible
  expect --role button --name "Rename" visible

scenario "loads net worth graph and checks visuals"
  click --role button --name "Net Worth"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-networth-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-networth-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-networth-midnight --max-diff-pixels 5000

scenario "loads cash flow graph and checks visuals"
  click --role button --name "Cash Flow"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-cashflow-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-cashflow-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-cashflow-midnight --max-diff-pixels 5000

scenario "opens the date range picker and checks visuals"
  click --role button --name "Net Worth"
  click --testid date-range-picker-trigger
  expect --selector "[data-popover]" visible
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-picker-auto --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-picker-dark --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-picker-midnight --selector "[data-popover]" --max-diff-pixels 5000
  click --role button --name "Day"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-picker-day-auto --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-picker-day-dark --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-picker-day-midnight --selector "[data-popover]" --max-diff-pixels 5000

# --- balance forecast setup, inlined per scenario (upstream describe
# before-each): Settings -> Experimental -> check "Balance Forecast
# Report", back to reports, "Add new widget" -> "Balance forecast",
# then scroll the dashboard grid until the Balance Forecast card
# renders and click its button (W12: scroll, poll for the heading,
# reverse-iterate to the card and click its navigate button, as
# upstream scrolls in a retry loop), wait for /reports/forecast/
# and the Monthly button.
scenario "loads balance forecast report with monthly granularity"
  click --role link --name "Settings"
  expect --testid settings visible
  click --role link --name "Experimental"
  click --role checkbox --name "Balance Forecast Report"
  expect js "document.querySelector('#settings-flag-balanceForecastReport').checked"
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible
  click --role button --name "Add new widget"
  click --role button --name "Balance forecast"
  wait --ms 1000
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(const i of items){i.scrollIntoView();}return items.length})()"
  expect js "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];return items.some(i=>[...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim())))})()"
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(let k=items.length-1;k>=0;k--){const i=items[k];if([...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim()))){const b=[...i.querySelectorAll('button')].find(x=>/^Balance Forecast/.test(x.textContent.trim()));if(b){b.click();return true;}}}return false})()"
  expect url contains "/reports/forecast/"
  expect --role button --name "Monthly" visible
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot forecast-monthly-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot forecast-monthly-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot forecast-monthly-midnight --max-diff-pixels 5000

scenario "switches to daily granularity"
  click --role link --name "Settings"
  expect --testid settings visible
  click --role link --name "Experimental"
  click --role checkbox --name "Balance Forecast Report"
  expect js "document.querySelector('#settings-flag-balanceForecastReport').checked"
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible
  click --role button --name "Add new widget"
  click --role button --name "Balance forecast"
  wait --ms 1000
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(const i of items){i.scrollIntoView();}return items.length})()"
  expect js "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];return items.some(i=>[...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim())))})()"
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(let k=items.length-1;k>=0;k--){const i=items[k];if([...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim()))){const b=[...i.querySelectorAll('button')].find(x=>/^Balance Forecast/.test(x.textContent.trim()));if(b){b.click();return true;}}}return false})()"
  expect url contains "/reports/forecast/"
