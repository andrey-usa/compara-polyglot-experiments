scenario "loads tracking budget forecast report"
  click --role link --name "Settings"
  expect --testid settings visible
  click --role link --name "Experimental"
  click --role checkbox --name "Balance Forecast Report"
  expect js "document.querySelector('#settings-flag-balanceForecastReport').checked"
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible
  click --role button --name "Add new widget"
  click --role button --name "Balance forecast"
  wait --ms 1000
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(const i of items){i.scrollIntoView();}return items.length})()"
  expect js "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];return items.some(i=>[...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim())))})()"
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(let k=items.length-1;k>=0;k--){const i=items[k];if([...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim()))){const b=[...i.querySelectorAll('button')].find(x=>/^Balance Forecast/.test(x.textContent.trim()));if(b){b.click();return true;}}}return false})()"
  expect url contains "/reports/forecast/"
  expect --role button --name "Monthly" visible
  click --role link --name "Settings"
  expect --testid settings visible
  click --role link --name "General"
  if --role button --name "Switch to tracking budgeting" visible
    click --role button --name "Switch to tracking budgeting"
  click --role link --name "Budget"
  expect --testid budget-table visible
  click --selector "[title='Next month']"
  wait --ms 800
  eval "(()=>{document.querySelectorAll('[data-pv-budget]').forEach(e=>e.removeAttribute('data-pv-budget'));const row=[...document.querySelectorAll('[data-testid=budget-table] [data-testid=row]')].find(r=>r.textContent.includes('Food'));const cell=row?.querySelector('[data-testid=budget]');if(!cell)return false;cell.setAttribute('data-pv-budget','1');cell.scrollIntoView();return true})()"
  click --selector "[data-pv-budget='1']"
  fill --selector "[data-testid='budget'] input" "1200"
  press Enter
  click --selector "[title='Next month']"
  wait --ms 800
  eval "(()=>{document.querySelectorAll('[data-pv-budget]').forEach(e=>e.removeAttribute('data-pv-budget'));const row=[...document.querySelectorAll('[data-testid=budget-table] [data-testid=row]')].find(r=>r.textContent.includes('Food'));const cell=row?.querySelector('[data-testid=budget]');if(!cell)return false;cell.setAttribute('data-pv-budget','1');cell.scrollIntoView();return true})()"
  click --selector "[data-pv-budget='1']"
  fill --selector "[data-testid='budget'] input" "1200"
  press Enter
  click --selector "[title='Next month']"
  wait --ms 800
  eval "(()=>{document.querySelectorAll('[data-pv-budget]').forEach(e=>e.removeAttribute('data-pv-budget'));const row=[...document.querySelectorAll('[data-testid=budget-table] [data-testid=row]')].find(r=>r.textContent.includes('Food'));const cell=row?.querySelector('[data-testid=budget]');if(!cell)return false;cell.setAttribute('data-pv-budget','1');cell.scrollIntoView();return true})()"
  click --selector "[data-pv-budget='1']"
  fill --selector "[data-testid='budget'] input" "1200"
  press Enter
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible
  wait --ms 1000
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(const i of items){i.scrollIntoView();}return items.length})()"
  expect js "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];return items.some(i=>[...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim())))})()"
  eval "(()=>{const items=[...document.querySelectorAll('[data-testid=reports-page] .react-grid-item')];for(let k=items.length-1;k>=0;k--){const i=items[k];if([...i.querySelectorAll('h1,h2,h3,h4')].some(x=>/^Balance Forecast/i.test(x.textContent.trim()))){const b=[...i.querySelectorAll('button')].find(x=>/^Balance Forecast/.test(x.textContent.trim()));if(b){b.click();return true;}}}return false})()"
  expect url contains "/reports/forecast/"
  expect --role button --name "Monthly" visible
  click --role button --name "Scheduled transactions"
  click --role button --name "Tracking budget"
  expect --role button --name "Tracking budget" visible
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot forecast-tracking-auto --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot forecast-tracking-dark --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot forecast-tracking-midnight --max-diff-pixels 5000

# --- custom reports: each scenario starts with the describe
# before-each (go to custom report page + tooltip-hiding style tag).
scenario "splits transactions into exact tag buckets and scopes them"
  click --role button --name "Add new widget"
  click --role button --name "New custom report"
  eval "(()=>{const s=document.createElement('style');s.textContent='[role=\"tooltip\"] { display: none !important; }';document.head.appendChild(s);return true})()"
  click --role link --name "Settings"
  expect --testid settings visible
  click --role link --name "Tags"
  click --role button --name "Add New"
  fill --placeholder "New tag" "red"
  click --selector "[data-testid='new-tag'] [data-testid='add-button']"
  expect text "#red"
  fill --placeholder "New tag" "circle"
  click --selector "[data-testid='new-tag'] [data-testid='add-button']"
  expect text "#circle"
  click --role link --name "Capital One Checking"
  expect --testid transaction-table visible
  click --role button --name "Add New"
  wait --ms 600
  click --selector "[data-testid='new-transaction'] [data-testid='debit']"
  fill --selector "[data-testid='new-transaction'] [data-testid='debit'] input" "10.00" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='payee']"
  fill --selector "[data-testid='new-transaction'] [data-testid='payee'] input" "Kroger" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='notes']"
  fill --selector "[data-testid='new-transaction'] [data-testid='notes'] input" "#red"
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='category']"
  fill --selector "[data-testid='new-transaction'] [data-testid='category'] input" "Food" --keys
  press Tab
  click --testid add-button
  click --role button --name "Cancel"
  click --role button --name "Add New"
  wait --ms 600
  click --selector "[data-testid='new-transaction'] [data-testid='debit']"
  fill --selector "[data-testid='new-transaction'] [data-testid='debit'] input" "20.00" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='payee']"
  fill --selector "[data-testid='new-transaction'] [data-testid='payee'] input" "Kroger" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='notes']"
  fill --selector "[data-testid='new-transaction'] [data-testid='notes'] input" "#circle"
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='category']"
  fill --selector "[data-testid='new-transaction'] [data-testid='category'] input" "Food" --keys
  press Tab
  click --testid add-button
  click --role button --name "Cancel"
  click --role button --name "Add New"
  wait --ms 600
  click --selector "[data-testid='new-transaction'] [data-testid='debit']"
  fill --selector "[data-testid='new-transaction'] [data-testid='debit'] input" "30.00" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='payee']"
  fill --selector "[data-testid='new-transaction'] [data-testid='payee'] input" "Kroger" --keys
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='notes']"
  fill --selector "[data-testid='new-transaction'] [data-testid='notes'] input" "#red #circle"
  press Tab
  click --selector "[data-testid='new-transaction'] [data-testid='category']"
  fill --selector "[data-testid='new-transaction'] [data-testid='category'] input" "Food" --keys
  press Tab
  click --testid add-button
  click --role button --name "Cancel"
  click --role link --name "Reports"
  expect --testid reports-page visible
  expect --role button --name "Net Worth" visible
  click --role button --name "Add new widget"
  click --role button --name "New custom report"
  eval "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');const b=el?.parentElement?.querySelector('button');if(!b)return false;b.scrollIntoView();const r=b.getBoundingClientRect();const c={bubbles:true,cancelable:true,button:0,clientX:r.left+r.width/2,clientY:r.top+r.height/2};b.dispatchEvent(new PointerEvent('pointerover',{...c,pointerType:'mouse',isPrimary:true}));b.dispatchEvent(new PointerEvent('pointerdown',{...c,pointerType:'mouse',isPrimary:true,buttons:1}));b.dispatchEvent(new MouseEvent('mousedown',{...c,buttons:1}));b.focus();b.dispatchEvent(new PointerEvent('pointerup',{...c,pointerType:'mouse',isPrimary:true,buttons:0}));b.dispatchEvent(new MouseEvent('mouseup',{...c,buttons:0}));b.dispatchEvent(new MouseEvent('click',{...c,buttons:0}));return true})()"
  expect --role button --name "Tag" visible
  click --role button --name "Tag"
  expect js "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');return el?.parentElement?.querySelector('button')?.textContent.trim()})()" is "Tag"
  click --role button --name "Data Table"
  expect text "#red"
  expect text "#circle"
  expect text "#circle + #red"
  expect --selector "[data-testid='report-row-#circle + #red']" text contains "-30.00"
  click --role button --name "Tag scope: All tags"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-tag-scope-auto --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-tag-scope-dark --selector "[data-popover]" --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-tag-scope-midnight --selector "[data-popover]" --max-diff-pixels 5000
  press Escape
  eval "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');const row=el?.parentElement;if(row){row.setAttribute('data-pv-split','1');}return !!row})()"
  eval "window.Actual.setTheme('auto')"
  expect --selector "[data-theme]" attr data-theme is auto
  expect screenshot reports-split-row-auto --selector "[data-pv-split='1']" --max-diff-pixels 5000
  eval "window.Actual.setTheme('dark')"
  expect --selector "[data-theme]" attr data-theme is dark
  expect screenshot reports-split-row-dark --selector "[data-pv-split='1']" --max-diff-pixels 5000
  eval "window.Actual.setTheme('midnight')"
  expect --selector "[data-theme]" attr data-theme is midnight
  expect screenshot reports-split-row-midnight --selector "[data-pv-split='1']" --max-diff-pixels 5000
  eval "(()=>{const cell=[...document.querySelectorAll('[data-testid=\"report-row-#circle + #red\"] *')].find(e=>e.textContent.trim()==='-30.00');cell?.click();return !!cell})()"
  expect url contains "/accounts"
  expect js "[...document.querySelectorAll('[data-testid=transaction-table] [data-testid=notes]')].filter(n=>n.textContent.includes('#red #circle')).length" is 1
  expect js "[...document.querySelectorAll('[data-testid=transaction-table] [data-testid=notes]')].map(n=>n.textContent.trim()).filter(t=>t.includes('#')).join('|')" is "#red #circle"
  back
  expect --testid reports-page visible
  eval "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');const b=el?.parentElement?.querySelector('button');if(!b)return false;b.scrollIntoView();const r=b.getBoundingClientRect();const c={bubbles:true,cancelable:true,button:0,clientX:r.left+r.width/2,clientY:r.top+r.height/2};b.dispatchEvent(new PointerEvent('pointerover',{...c,pointerType:'mouse',isPrimary:true}));b.dispatchEvent(new PointerEvent('pointerdown',{...c,pointerType:'mouse',isPrimary:true,buttons:1}));b.dispatchEvent(new MouseEvent('mousedown',{...c,buttons:1}));b.focus();b.dispatchEvent(new PointerEvent('pointerup',{...c,pointerType:'mouse',isPrimary:true,buttons:0}));b.dispatchEvent(new MouseEvent('mouseup',{...c,buttons:0}));b.dispatchEvent(new MouseEvent('click',{...c,buttons:0}));return true})()"
  expect --role button --name "Tag" visible
  click --role button --name "Tag"
  expect js "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');return el?.parentElement?.querySelector('button')?.textContent.trim()})()" is "Tag"
  click --role button --name "Data Table"
  click --role button --name "Tag scope: All tags"
  fill --role textbox --name "Search tags" "red"
  click --role button --name "#red"
  expect js "[...document.querySelectorAll('[data-testid=tag-scope-popover] button')].some(b=>b.textContent.includes('#red'))"
  click --role button --name "Apply"
  expect --role button --name "Tag scope: #red" visible
  expect --selector "[data-testid='report-row-#red']" text contains "-40.00"
  expect not text "#circle + #red"
  eval "(()=>{document.querySelectorAll('[data-pv-type-trigger]').forEach(e=>e.removeAttribute('data-pv-type-trigger'));const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Type:');const b=el?.parentElement?.querySelector('button');if(!b)return false;b.setAttribute('data-pv-type-trigger','1');b.scrollIntoView();return true})()"
  click --selector "[data-pv-type-trigger='1']"
  expect --role button --name "Budgeted" visible
  click --role button --name "Budgeted"
  expect js "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');return el?.parentElement?.querySelector('button')?.textContent.trim()})()" is "Category"

scenario "warns about missing scoped tags without transaction filters"
  click --role button --name "Add new widget"
  click --role button --name "New custom report"
  eval "(()=>{const s=document.createElement('style');s.textContent='[role=\"tooltip\"] { display: none !important; }';document.head.appendChild(s);return true})()"
  eval "(()=>{sessionStorage.setItem('url', window.location.pathname);sessionStorage.setItem('report', JSON.stringify({groupBy:'Tag',tagScope:{mode:'selected',tagIds:['deleted-tag-id']},conditions:[]}));return true})()"
  reload
  expect js "document.body.innerText.match(/non-existing filter or tag/) !== null"
  eval "(()=>{const el=[...document.querySelectorAll('*')].find(e=>e.textContent.trim()==='Split:');const b=el?.parentElement?.querySelector('button');if(b){b.scrollIntoView();b.click();}return !!b})()"
  wait --ms 1000
  click --role button --name "Category"
  expect js "document.body.innerText.match(/non-existing filter or tag/) === null"

scenario "Switches to Data Table and checks the visuals"
  click --role button --name "Add new widget"
  click --role button --name "New custom report"
  eval "(()=>{const s=document.createElement('style');s.textContent='[role=\"tooltip\"] { display: none !important; }';document.head.appendChild(s);return true})()"
