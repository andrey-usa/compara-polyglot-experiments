scenario "Bar Graph keeps its height when the legend needs scrolling"
  click --role button --name "Add new widget"
  click --role button --name "New custom report"
  eval "(()=>{const s=document.createElement('style');s.textContent='[role=\"tooltip\"] { display: none !important; }';document.head.appendChild(s);return true})()"
  set viewport 1280 700
  click --role button --name "Time"
  click --role button --name "Bar Graph"
  click --role button --name "Options"
  click --role button --name "Show empty rows"
  press Escape
  expect --selector "#custom-report-content .recharts-wrapper" visible
  eval "window.__h0 = document.querySelector('#custom-report-content .recharts-wrapper').clientHeight"
  click --role button --name "Show Summary"
  click --role button --name "Show Legend"
  expect js "document.querySelector('#custom-report-content .recharts-wrapper').clientHeight === window.__h0" --timeout-ms 10000
  eval "(()=>{const els=[...document.querySelectorAll('#custom-report-content *')].filter(e=>e.textContent.trim()==='Category'&&e.children.length===0);const leg=els[0]?.parentElement;if(leg){leg.setAttribute('data-pv-legend','1');window.__legend=leg;}return !!leg})()"
  expect js "window.__legend.scrollHeight > window.__legend.clientHeight" --timeout-ms 10000
  hover --selector "[data-pv-legend='1']"
  mouse wheel 0 500
  expect js "window.__legend.scrollTop > 0" --timeout-ms 10000
  expect js "document.querySelector('#custom-report-content .recharts-wrapper').clientHeight === window.__h0" --timeout-ms 10000

