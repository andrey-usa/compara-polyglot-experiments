# tour.test.ts converted from Playwright (Actual Budget e2e @ dff6b4b)
# 2 upstream tests, 2 scenarios. Upstream: fresh demo budget per test
# (createTestFile = click "Try the demo", wait for budget-table).
# Tour flow: Help menu -> "Take a tour" opens the tour tooltip
# (data-testid tour-tooltip, not a dialog role — W10: the previous
# port's dialog locator never matched); each step shows "N of total"
# and a Next button; the last step shows Finish, which closes the
# tour. The skip test clicks "Skip tour" on the first step and
# expects the tour tooltip gone.
# Port kind: literal for both tests, except W14 (walk unrolled, see
# the scenario): the tour step counter is asserted with a text
# contains check after each Next click, as upstream asserts the
# counter after each click.
# W1-W3 (pilot): not needed here. W14: see the walk scenario.
# Requires: set ua "playwright" (pilot G3: matches upstream config
# userAgent, seeds deterministic demo data).
base http://127.0.0.1:3001

before each
  set ua "playwright"
  goto /
  click --role button --name "Try the demo"
  expect --testid budget-table visible --timeout-ms 60000

scenario "walks through each tour step"
  click --role button --name "Help"
  click --role button --name "Take a tour"
  expect --testid tour-tooltip visible
  # Upstream reads the total from the "N of total" counter, then clicks
  # Next until the last step, asserting the counter after each click.
  # W14: that loop is unrolled here — a synchronous eval loop never
  # lets React re-render between clicks, so the tour never advanced
  # and Finish never appeared. Each step below clicks Next inside
  # the tooltip, then asserts the counter, giving React a render
  # between steps. Total is 8 steps at the pinned commit (steps.tsx:
  # Welcome, Your Budget, Saved/To Budget, Categories, Month by
  # Month, Getting Around, Add Your Accounts, Getting Help).
  expect --testid tour-tooltip text contains "Welcome to Actual!"
  expect --testid tour-tooltip text contains "1 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "2 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "3 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "4 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "5 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "6 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "7 of 8"
  eval "(()=>{const t=document.querySelector('[data-testid=tour-tooltip]');const b=[...t.querySelectorAll('button')].find(x=>x.textContent.trim()==='Next');b?.click();return !!b})()"
  expect --testid tour-tooltip text contains "8 of 8"
  expect --testid tour-tooltip text contains "Getting Help"
  expect --role button --name "Finish" visible
  click --role button --name "Finish"
  expect not --testid tour-tooltip visible

scenario "skips the tour"
  click --role button --name "Help"
  click --role button --name "Take a tour"
  expect --testid tour-tooltip visible
  expect --role button --name "Skip tour" visible
  click --role button --name "Skip tour"
  expect not --testid tour-tooltip visible
