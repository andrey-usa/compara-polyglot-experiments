# download: a real download the server counts (Content-Disposition);
# the verdict endpoint is the server's ground truth.

scenario "Downloading the report is a real download"
  goto ${GAUNTLET_URL:-http://127.0.0.1:18201}/download --wait commit
  click --selector "#dl"
  wait --download "*.csv" --timeout-ms 30000
  expect download "report*.csv"
  expect ${download.name} matches "^report( \([0-9]+\))?\.csv$"
  expect js "fetch('/verdict/download').then((r) => r.json()).then((j) => j.legitimate)"
