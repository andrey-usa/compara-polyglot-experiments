+// on empty page where the button used to be.
+let x = 60, frames = 0;
+const glide = () => {
+  if (frames++ >= 12) return;
+  x += 40;
+  document.getElementById('mover').style.left = x + 'px';
+  requestAnimationFrame(glide);
+};
+requestAnimationFrame(glide);
+</script>""")
