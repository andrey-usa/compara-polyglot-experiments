  press Tab
  click --role button --name "Add"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='payee']" --nth 2 text is "Apple"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='account']" --nth 2 text is "HSBC"
  expect js "document.querySelectorAll('[data-testid=table] [data-testid=row] [data-testid=amount]')[2].textContent.replace(/\s+/g,' ').trim()==='~5.00'"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 2 text is "Due"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='payee']" --nth 3 text is "Apple"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='account']" --nth 3 text is "HSBC"
  expect js "document.querySelectorAll('[data-testid=table] [data-testid=row] [data-testid=amount]')[3].textContent.replace(/\s+/g,' ').trim()==='~5.00'"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 3 text is "Due"
  click --selector "[data-testid='table'] [data-testid='row'] [data-testid='actions'] button" --nth 2
  wait --ms 400
  click --role button --name "Post transaction today"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 2 text is "Paid"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 3 text is "Due"
  click --selector "[data-testid='table'] [data-testid='row'] [data-testid='actions'] button" --nth 3
  wait --ms 400
  click --role button --name "Post transaction today"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 2 text is "Paid"
  expect --selector "[data-testid='table'] [data-testid='row'] [data-testid='status']" --nth 3 text is "Paid"
  click --role link --name "HSBC"
  expect --testid transaction-table visible
  wait --js "document.querySelectorAll('[data-testid=transaction-table] [data-testid=row]').length>=2" --timeout-ms 15000
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='payee']" --nth 0 text is "Apple"
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='category']" --nth 0 text is "Categorize"
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='debit']" --nth 0 text is "5.00"
  expect js "document.querySelectorAll('[data-testid=transaction-table] [data-testid=row]')[0].querySelector('[data-testid=credit]').textContent.trim()===''"
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='payee']" --nth 1 text is "Apple"
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='category']" --nth 1 text is "Categorize"
  expect --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='debit']" --nth 1 text is "5.00"
  expect js "document.querySelectorAll('[data-testid=transaction-table] [data-testid=row]')[1].querySelector('[data-testid=credit]').textContent.trim()===''"
  hover --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='payee'] [data-testid='schedule-icon']" --nth 0
  wait --ms 500
  hover --selector "[data-testid='transaction-table'] [data-testid='row'] [data-testid='payee'] [data-testid='schedule-icon']" --nth 1
  wait --ms 500

