# shadow-open-unnamed: an icon-only button (aria-hidden, no accessible
# name) in an open shadow root.
# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

scenario "Clicking the nameless button in an open shadow root"
  goto ${GAUNTLET_URL:-http://127.0.0.1:18201}/shadow-open-unnamed --wait commit
  click --text "▶"
  expect --selector "#out" text is "played"
