# Cart page: line items and subtotal math (3 x $60.32 = $180.96).
use common.pv

# NOTE: relative URLs resolve against --base-url (or PRIMAVERA_BASE_URL);
# the gauntlet origin comes from GAUNTLET_URL.

before each
  goto /shop --wait commit
  run accept-cookies

scenario "The cart shows line items and the subtotal"
  goto /shop/p/101 --wait commit
  fill --selector "#qty" --value "3"
  click --selector "#detail-add"
  expect --selector "#cart-count" text is 3
  goto /cart --wait commit
  expect text "Brass Widget"
  expect --selector "#subtotal" text is "$180.96"
  expect js "document.querySelector('#qty-101').value" is "3"
